{
  "info": {
    "name": "Golden Skills - Referral APIs",
    "_postman_id": "golden-skills-referral-v1",
    "description": "Complete Referral Token APIs for Golden Skills Backend\n\n✅ Step by Step Order:\n1. Admin Login → token copy karo\n2. Create User → myReferralCode note karo\n3. Validate Referral Code\n4. Register New User (us code se)\n5. User Login → user token lo\n6. Get My Referral Info",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.18.92:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "myReferralCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "STEP 1 — Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('adminToken', json.token);",
              "    console.log('✅ Admin token saved!');",
              "    pm.test('Admin Login Success', () => pm.response.to.have.status(200));",
              "} else {",
              "    pm.test('Admin Login Failed', () => { throw new Error('No token in response'); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{ADMIN_PASSWORD}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Admin login karo — token automatically save ho jaayega collection variable mein"
      },
      "response": []
    },
    {
      "name": "STEP 2 — Admin: Create User (myReferralCode milega)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.success && json.user && json.user.myReferralCode) {",
              "    pm.collectionVariables.set('myReferralCode', json.user.myReferralCode);",
              "    console.log('✅ myReferralCode saved: ' + json.user.myReferralCode);",
              "    pm.test('User Created Successfully', () => pm.response.to.have.status(201));",
              "} else if (json.message && json.message.includes('already exists')) {",
              "    pm.test('User already exists — change email in body', () => { throw new Error(json.message); });",
              "} else {",
              "    pm.test('Create User Failed', () => { throw new Error(JSON.stringify(json)); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmad\",\n  \"lastName\": \"Khan\",\n  \"email\": \"ahmad.referrer@gmail.com\",\n  \"password\": \"test1234\",\n  \"age\": 25,\n  \"city\": \"Karachi\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/create",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "create"]
        },
        "description": "Admin ek user create karta hai — response mein myReferralCode aayega jo automatically save ho jaayega"
      },
      "response": []
    },
    {
      "name": "STEP 3 — Validate Referral Code (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "if (json.valid) {",
              "    pm.test('Referral Code is VALID ✅', () => pm.expect(json.valid).to.be.true);",
              "    console.log('Referrer Name: ' + json.referrerName);",
              "} else {",
              "    pm.test('Referral Code is INVALID ❌', () => pm.expect(json.valid).to.be.true);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referralCode\": \"{{myReferralCode}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/validate-referral",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "validate-referral"]
        },
        "description": "Koi bhi referral code validate kar sakta hai — login ki zaroorat nahi"
      },
      "response": []
    },
    {
      "name": "STEP 3b — Validate INVALID Code (Error Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Invalid code returns valid:false', () => pm.expect(json.valid).to.be.false);",
              "console.log('Message: ' + json.message);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referralCode\": \"GS-FAKE-0000-XXXX\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/validate-referral",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "validate-referral"]
        },
        "description": "Galat referral code test — valid:false aana chahiye"
      },
      "response": []
    },
    {
      "name": "STEP 4 — Register New User (Referral Code se)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.success) {",
              "    pm.test('User Registered Successfully ✅', () => pm.response.to.have.status(201));",
              "    console.log('New user myReferralCode: ' + json.user.myReferralCode);",
              "} else {",
              "    pm.test('Registration Failed ❌', () => { throw new Error(JSON.stringify(json)); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ali\",\n  \"lastName\": \"Hassan\",\n  \"email\": \"ali.newuser@gmail.com\",\n  \"city\": \"Lahore\",\n  \"password\": \"test1234\",\n  \"referralCode\": \"{{myReferralCode}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "register"]
        },
        "description": "Naya user register karo Ahmad Khan ke referral code se — referralCode automatically use hoga"
      },
      "response": []
    },
    {
      "name": "STEP 4b — Register WITHOUT Referral Code (Error Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Referral code required error', () => pm.expect(json.success).to.be.false);",
              "console.log('Errors: ' + JSON.stringify(json.errors));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"test.noreferral@gmail.com\",\n  \"city\": \"Islamabad\",\n  \"password\": \"test1234\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "register"]
        },
        "description": "Referral code ke bina register — 400 error aana chahiye"
      },
      "response": []
    },
    {
      "name": "STEP 4c — Register with SELF Referral Code (Error Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Self referral blocked', () => pm.expect(json.message).to.include('own referral'));",
              "console.log('Message: ' + json.message);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ahmad\",\n  \"lastName\": \"Khan\",\n  \"email\": \"ahmad.referrer@gmail.com\",\n  \"city\": \"Karachi\",\n  \"password\": \"test1234\",\n  \"referralCode\": \"{{myReferralCode}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "register"]
        },
        "description": "Apna hi referral code use karna — 400 error aana chahiye (self-referral blocked)"
      },
      "response": []
    },
    {
      "name": "STEP 5 — User Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('userToken', json.token);",
              "    console.log('✅ User token saved!');",
              "    pm.test('User Login Success', () => pm.response.to.have.status(200));",
              "} else {",
              "    pm.test('User Login Failed', () => { throw new Error('No token'); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ali.newuser@gmail.com\",\n  \"password\": \"test1234\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "login"]
        },
        "description": "Registered user login karo — token automatically save ho jaayega"
      },
      "response": []
    },
    {
      "name": "STEP 6 — Get My Referral Info (Auth Required)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has myReferralCode', () => pm.expect(json.myReferralCode).to.exist);",
              "pm.test('Has referredUsersCount', () => pm.expect(json.referredUsersCount).to.be.a('number'));",
              "console.log('My Referral Code: ' + json.myReferralCode);",
              "console.log('Referred Users Count: ' + json.referredUsersCount);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/referral-info",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "referral-info"]
        },
        "description": "Apna referral code aur kitne logon ne use kiya — user token required"
      },
      "response": []
    },
    {
      "name": "STEP 6b — Get Referral Info WITHOUT Token (Error Case)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
              "console.log('Response: ' + pm.response.text());"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/referral-info",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "user", "referral-info"]
        },
        "description": "Token ke bina request — 401 Unauthorized aana chahiye"
      },
      "response": []
    },
    {
      "name": "BONUS — Get All Users (Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has users array', () => pm.expect(json.users).to.be.an('array'));",
              "console.log('Total Users: ' + json.total);",
              "console.log('Current Page: ' + json.page + ' / ' + json.totalPages);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/users?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "users"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        },
        "description": "Admin — saare users dekho with pagination"
      },
      "response": []
    }
  ]
}
